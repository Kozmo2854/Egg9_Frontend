# ===========================================
# Egg9 Frontend Environment Configuration
# ===========================================
# Copy this file to .env and update values

# API Backend URL
# ---------------------------------------------
# LOCAL DEVELOPMENT (phone connecting to your computer):
#   1. Find your computer's IP: hostname -I | awk '{print $1}'
#   2. Use that IP below, e.g.: http://192.168.1.100:8000/api
#   3. Run Laravel with: php artisan serve --host=0.0.0.0
#
# PRODUCTION (Railway):
#   Use your Railway backend URL
# ---------------------------------------------
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8000/api

# App Environment (development | production)
EXPO_PUBLIC_APP_ENV=development
